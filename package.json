{
  "name": "dsh-gateway-mobile",
  "version": "0.1.4",
  "description": "Secure DSH mobile and WeChat gateway: Cloudflare Quick Tunnel, one-time pairing, WeChat ClawBot/iLink chat, approvals, questions, and notifications.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "web",
    "locale",
    "scripts/doctor.mjs",
    "scripts/hmr-check.mjs",
    "scripts/check-docs.mjs",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "test:integration": "npm run build && node scripts/integration-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "hmr-check": "node scripts/hmr-check.mjs",
    "check-docs": "node scripts/check-docs.mjs",
    "admin": "node scripts/open-admin.mjs",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cloudflare-tunnel",
    "mobile",
    "remote-access",
    "wechat",
    "clawbot",
    "ilink"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
